{
  "name": "heat-atlas-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Static frontend for Heat Atlas. No build step: the site runs from these files as they are. npm is only needed to re-create vendor/ bundles.",
  "scripts": {
    "start": "python3 -m http.server 5173",
    "vendor": "npm run vendor:globe && npm run vendor:motion && npm run vendor:geo && npm run vendor:leaflet && npm run vendor:css",
    "vendor:globe": "esbuild tools/vendor-src/globe.js --bundle --format=esm --minify --outfile=vendor/globe.js",
    "vendor:motion": "esbuild tools/vendor-src/motion.js --bundle --format=esm --minify --outfile=vendor/motion.js",
    "vendor:geo": "esbuild tools/vendor-src/geo.js --bundle --format=esm --minify --outfile=vendor/geo.js",
    "vendor:leaflet": "esbuild tools/vendor-src/leaflet.js --bundle --format=esm --minify --outfile=vendor/leaflet.js",
    "vendor:css": "cp node_modules/leaflet/dist/leaflet.css vendor/leaflet.css && cp node_modules/leaflet-draw/dist/leaflet.draw.css vendor/leaflet.draw.css",
    "geo": "node tools/build-geo.mjs"
  },
  "devDependencies": {
    "d3-geo": "3.1.2",
    "d3-scale": "4.0.3",
    "d3-shape": "3.2.1",
    "esbuild": "0.28.2",
    "globe.gl": "2.46.2",
    "gsap": "3.15.1",
    "h3-js": "4.5.0",
    "leaflet": "1.9.4",
    "leaflet-draw": "1.0.4",
    "lenis": "1.3.27",
    "three": "0.187.0"
  }
}
