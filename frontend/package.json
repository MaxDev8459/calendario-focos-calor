{
  "name": "heat-atlas-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Static frontend for Heat Atlas. No build step: the site runs from these files as they are. npm is only needed to re-create vendor/ bundles.",
  "scripts": {
    "start": "python3 -m http.server 5173",
    "vendor": "npm run vendor:motion && npm run vendor:geo && npm run vendor:maplibre",
    "vendor:motion": "esbuild tools/vendor-src/motion.js --bundle --format=esm --minify --outfile=vendor/motion.js",
    "vendor:geo": "esbuild tools/vendor-src/geo.js --bundle --format=esm --minify --outfile=vendor/geo.js",
    "vendor:maplibre": "mkdir -p vendor/maplibre && cp node_modules/maplibre-gl/dist/maplibre-gl.mjs node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs node_modules/maplibre-gl/dist/maplibre-gl.css node_modules/maplibre-gl/LICENSE.txt vendor/maplibre/",
    "geo": "node tools/build-geo.mjs"
  },
  "devDependencies": {
    "d3-geo": "3.1.2",
    "d3-scale": "4.0.3",
    "d3-shape": "3.2.1",
    "esbuild": "0.28.2",
    "gsap": "3.15.1",
    "h3-js": "4.5.0",
    "lenis": "1.3.27",
    "maplibre-gl": "6.18.0"
  }
}
